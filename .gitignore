# Node modules (dependencies)
node_modules/

# Environment variables (passwords, database credentials, API keys)
.env

# Logs
logs/
*.log

# Cache & temporary files
tmp/
*.cache

# Compiled files (if using TypeScript or Babel)
dist/
build/

# Database files (optional)
database/
*.sqlite
*.db

# Debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific files
.DS_Store  # macOS
Thumbs.db  # Windows
